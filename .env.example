# ---------------------------------------------------------------
# Forma3D environment configuration. Copy to .env and edit.
# Never commit .env.
# ---------------------------------------------------------------
# production: refuses default/short secrets, hides the API docs. Use `development` only for local tests.
APP_ENV=production
LOG_LEVEL=INFO
# Image tag used by docker compose (set by the offline bundle; `local` when building on the host)
FORMA3D_VERSION=local

# Public port for the frontend/reverse proxy. FRONTEND_BIND=127.0.0.1 when a TLS proxy runs in front.
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0

# PostgreSQL
POSTGRES_DB=forma3d
POSTGRES_USER=forma3d
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://forma3d:change-me@postgres:5432/forma3d

# Redis
REDIS_URL=redis://redis:6379/0

# Secrets: generate with `deployment/scripts/generate-secrets.sh`, which writes them here (or into
# deployment/secrets/ for the secrets overlay, in which case leave these three lines empty).
# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# true when the site is served over HTTPS (refresh cookie gets the Secure flag)
COOKIE_SECURE=false

# Internal service-to-service token (backend <-> workers)
INTERNAL_SERVICE_TOKEN=change-me-internal

# Storage
DATA_ROOT=/data

# Modeling / Blender jobs
JOB_TIMEOUT_SECONDS=300
RENDER_TIMEOUT_SECONDS=900
# Eevee needs a GPU (docker-compose.gpu.yml); Cycles always works on the CPU
RENDER_EEVEE_ENABLED=false
MAX_PENDING_OUTPUTS=4
RENDER_THUMBNAILS=true
THUMBNAIL_SIZE=384
STAGING_ORPHAN_MINUTES=60
KEEP_FAILED_WORKSPACES=false
# Hard limits enforced by the validator (backend) and re-checked by the worker
MODELING_MAX_OPERATIONS_PER_BATCH=200
MODELING_MAX_SCENE_OBJECTS=500
MODELING_MAX_VERTICES_PER_OBJECT=200000
MODELING_MAX_SCENE_VERTICES=1000000

# Workers and resources (docker compose). Several Blender workers are safe (project lock + reclaim).
BLENDER_WORKERS=1
BLENDER_CPUS=2.0
BLENDER_MEMORY=4G
BLENDER_TMP_SIZE=2g
AGENT_WORKERS=1
BACKEND_CPUS=1.0
BACKEND_MEMORY=768M

# LLM (OpenAI-compatible, e.g. vLLM). LLM_PROVIDER=fake runs a deterministic offline planner
# (CI / demos: desk, black legs, drawers, walnut, export) without any model server.
LLM_PROVIDER=vllm
# Must be reachable from the agent-worker container (the `llm` network), e.g. http://10.0.0.5:8000/v1
LLM_BASE_URL=http://llm-server:8000/v1
LLM_MODEL=your-instruct-model
# Optional per-agent models (each falls back to LLM_MODEL); all use LLM_BASE_URL
LLM_MODEL_CONVERSATION=
LLM_MODEL_PLANNING=
LLM_MODEL_REVISION=
# Image-to-3D (photos attached in chat) needs a vision-capable model (Qwen-VL, Llama 3.2 Vision, ...)
LLM_MODEL_VISION=
# json_schema (vLLM >= 0.6 response_format) | guided_json (older vLLM extra body) | json_object | none
LLM_STRUCTURED_OUTPUT=json_schema
# Reasoning models (Qwen3, R1 distills): auto | on | off. off = much faster plans, same quality for DSL output
LLM_THINKING=auto
LLM_API_KEY=local-token
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Slow/large models: a full plan can be 1-3k tokens; size this to your server's tokens/s
LLM_TIMEOUT_SECONDS=300
AGENT_MAX_RETRIES=2
# QA -> Revision Agent -> rebuild loops per turn before the result is committed (warnings only) or rolled back
AGENT_MAX_REVISIONS=2
# LangGraph checkpointer: memory | sqlite:///path.db | postgresql://... (compose sets Postgres)
CHECKPOINT_URL=memory

# Accounts. The first account is always an administrator; these emails are made administrators too
# (comma-separated, applied at startup and at sign-up). Admins open Configuration from the avatar menu,
# where most settings in this file can be overridden at runtime without a restart.
ADMIN_EMAILS=
# false = only the first account can sign up; administrators can reopen it in Configuration -> Accounts
REGISTRATION_OPEN=true

# Defaults pre-selected in the Render and Export dialogs (also editable in Configuration)
DEFAULT_RENDER_QUALITY=standard
DEFAULT_RENDER_SIZE=1280x720
DEFAULT_EXPORT_FORMAT=glb
DEFAULT_EXPORT_UNIT=m

# Agent trace ("How this was made" in the chat). Users see step summaries; administrators also see the exact
# LLM prompt and raw answer of every call, if stored. Prompts are removed after N days (0 = keep); summaries stay.
AGENT_TRACE_PROMPTS=true
AGENT_TRACE_PROMPT_RETENTION_DAYS=14

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_JOBS_PER_MINUTE=10

# Recovery and retention (backend maintenance loop, docs/operations.md)
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=60
JOB_GRACE_SECONDS=300
AGENT_JOB_TIMEOUT_SECONDS=3600
QUEUED_JOB_TIMEOUT_SECONDS=3600
STAGED_JOB_TIMEOUT_SECONDS=1800
# days; 0 keeps forever. Versions of live projects are never purged.
DELETED_PROJECT_RETENTION_DAYS=30
OUTPUT_RETENTION_DAYS=30

# Monitoring: optional bearer token for GET /metrics (internal network only, never proxied)
METRICS_TOKEN=
