# ---------------------------------------------------------------
# Forma3D environment configuration. Copy to .env and edit.
# Never commit .env.
# ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Public port for the frontend/reverse proxy
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=forma3d
POSTGRES_USER=forma3d
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://forma3d:change-me@postgres:5432/forma3d

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=false

# Internal service-to-service token (backend <-> workers)
INTERNAL_SERVICE_TOKEN=change-me-internal

# Storage
DATA_ROOT=/data

# Modeling / Blender jobs
JOB_TIMEOUT_SECONDS=300
RENDER_THUMBNAILS=true
THUMBNAIL_SIZE=384
STAGING_ORPHAN_MINUTES=60
KEEP_FAILED_WORKSPACES=false
# Hard limits enforced by the validator (backend) and re-checked by the worker
MODELING_MAX_OPERATIONS_PER_BATCH=200
MODELING_MAX_SCENE_OBJECTS=500
MODELING_MAX_VERTICES_PER_OBJECT=200000
MODELING_MAX_SCENE_VERTICES=1000000

# LLM (OpenAI-compatible, e.g. vLLM). LLM_PROVIDER=fake runs a deterministic offline planner
# (CI / demos: desk, black legs, drawers, walnut, export) without any model server.
LLM_PROVIDER=vllm
# Must be reachable from the agent-worker container (the `llm` network), e.g. http://10.0.0.5:8000/v1
LLM_BASE_URL=http://llm-server:8000/v1
LLM_MODEL=your-instruct-model
# Optional per-agent override for the planner (falls back to LLM_MODEL)
LLM_MODEL_PLANNING=
# json_schema (vLLM >= 0.6 response_format) | guided_json (older vLLM extra body) | json_object | none
LLM_STRUCTURED_OUTPUT=json_schema
# Reasoning models (Qwen3, R1 distills): auto | on | off. off = much faster plans, same quality for DSL output
LLM_THINKING=auto
LLM_API_KEY=local-token
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Slow/large models: a full plan can be 1-3k tokens; size this to your server's tokens/s
LLM_TIMEOUT_SECONDS=300
AGENT_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=8

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_JOBS_PER_MINUTE=10
